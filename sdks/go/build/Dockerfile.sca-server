# syntax=docker/dockerfile:1
# Build the reference SCA server. Pure Go (no CGo).
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src

# Cache modules separately from sources.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/sca-server ./cmd/sca-server

# Distroless static, non-root.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/sca-server /usr/local/bin/sca-server
USER nonroot:nonroot
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/sca-server"]
CMD ["--config", "/etc/shadownet/sca-server.yaml"]
