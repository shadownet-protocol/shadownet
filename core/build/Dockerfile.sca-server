# syntax=docker/dockerfile:1
# Build the reference SCA server. Pure Go (no CGo).
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src

# Cache modules separately from sources.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/core/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/core/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/sca-server ./cmd/sca-server

# Stage an empty data directory so the distroless final image gets a
# pre-created /var/lib/shadownet owned by nonroot. Distroless has no shell
# or mkdir, so the writer (SQLite store) cannot create it at runtime.
RUN mkdir -p /out/data

# Distroless static, non-root.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/sca-server /usr/local/bin/sca-server
COPY --from=build --chown=nonroot:nonroot /out/data /var/lib/shadownet
USER nonroot:nonroot
EXPOSE 8443
# Declare /var/lib/shadownet as a volume mount point. Not load-bearing for
# correctness — the COPY above already creates it with the right ownership —
# but it signals intent to orchestrators and lets `docker volume` tooling
# surface the path.
VOLUME ["/var/lib/shadownet"]
# Containers ship with JSON-line logs for log aggregators. Override in dev
# with `-e SHADOWNET_LOG_FORMAT=text`.
ENV SHADOWNET_LOG_FORMAT=json
ENTRYPOINT ["/usr/local/bin/sca-server"]
CMD ["--config", "/etc/shadownet/sca-server.yaml"]
