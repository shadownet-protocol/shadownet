# Append this to ~/.hermes/config.yaml to wire Hermes Agent up to your Shadow.
# Get the URL and bearer token from https://app.sh4dow.org/connect.
#
# After editing, run `/reload-mcp` inside Hermes (or restart) to pick up the
# new server.
mcp_servers:
  shadownet:
    url: "<paste-mcp-endpoint-here>"
    headers:
      Authorization: "Bearer <paste-token-here>"
